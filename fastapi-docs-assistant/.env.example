# Copy to .env and fill in. Never commit .env.

# Used for embeddings, generation and (later) LLM-as-judge.
OPENAI_API_KEY=

# Optional: chat model for answers. Default is in config.py.
# List the models your key can use:
#   python -c "from openai import OpenAI; print(sorted(m.id for m in OpenAI().models.list()))"
# CHAT_MODEL=

# Step 8 retrieval (on by default). Set both to 0 to reproduce the Step 7 baseline.
# RETRIEVAL_NEIGHBORS=1
# QUERY_REWRITE=1

# Ragas (pip install -e ".[ragas]"). Defaults: metrics and questions use the eval judge,
# the knowledge graph uses the answering model (cheap, many calls).
# RAGAS_MODEL=
# RAGAS_KG_MODEL=
# RAGAS_QUESTION_MODEL=

# Phase 1 experiments (off until an eval shows they help)
# ANSWER_PROMPT=v2
# RERANK=ce                     # none | ce | llm
# REWRITE_REASONING_EFFORT=low

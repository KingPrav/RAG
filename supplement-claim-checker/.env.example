# Copy to .env and fill in. Never commit .env.

# NCBI asks every E-utilities client to identify itself with an email.
NCBI_EMAIL=you@example.com

# Optional but recommended: raises the rate limit from 3 to 10 requests/sec.
# Free at https://www.ncbi.nlm.nih.gov/account/settings/
NCBI_API_KEY=

# Used from Step 2 onward.
OPENAI_API_KEY=
